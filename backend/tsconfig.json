{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "commonjs",
    "target": "ES2020",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "typeRoots": [
      "./typing-stubs",
      "./node_modules/@types"
    ]
  }
  ,
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
